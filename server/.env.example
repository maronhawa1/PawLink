# Copy this file to .env and fill in your local values.
# Use your Supabase PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/pawlink

PORT=5001

# Required: a random secret of at least 32 characters.
# Generate it with: openssl rand -hex 32
# Paste the generated value into JWT_SECRET in your .env file.
JWT_SECRET=
CLIENT_ORIGINS=http://localhost:5173

# Supabase Storage for pet and report images (Project Settings -> API).
# The service role key is secret: keep it only in server/.env, never in the client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pawlink-images
